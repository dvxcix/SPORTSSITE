{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capabilities available to the primary SlipSurge window.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://www.slipsurge.com/*"]
  },
  "permissions": [
    "core:default",
    "deep-link:default",
    "notification:default",
    "opener:default"
  ]
}
