{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlipSurge",
  "version": "0.1.3",
  "identifier": "com.slipsurge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ..",
    "devUrl": "http://localhost:3000/feed?platform=desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Sports",
    "shortDescription": "Sports intelligence, odds movement, and community.",
    "longDescription": "SlipSurge brings live sports intelligence, odds movement, saved research, picks, and community into a focused desktop workspace.",
    "publisher": "SlipSurge LLC",
    "copyright": "Copyright SlipSurge LLC",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["slipsurge"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IDg3QzBCQjY4Rjc2QjIxRDgKUldUWUlXdjNhTHZBaDJxMm5POHdEbDhUQ0hBRzVPMDdFRlhmQmNHbmxMc1dhbGUxQU5NUFdVTUcK",
      "endpoints": [
        "https://www.slipsurge.com/api/desktop/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
