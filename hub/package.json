{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "mobile",
    "desktop"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit:production": "node scripts/audit-production.mjs",
    "test:production": "node --test scripts/production-smoke.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:production": "node scripts/browser-smoke.mjs --production",
    "test:hr-intelligence": "node --experimental-strip-types scripts/hr-intelligence-regression.mts",
    "test:fanduel-markets": "node --experimental-strip-types scripts/fanduel-market-regression.mts",
    "test:fanduel-archive": "node --experimental-strip-types scripts/fanduel-archive-regression.mts",
    "test:statcast-mappers": "node scripts/statcast-mapper-contract.test.mjs",
    "test:hr-mechanics": "node --test scripts/hr-mechanics-priors.test.mjs",
    "test:statcast-mechanics-readiness": "tsx --test scripts/statcast-mechanics-readiness.test.mts",
    "test:pregame-boundary": "node --experimental-strip-types --test scripts/pregame-feature-boundary.test.mts",
    "test:whop-access": "node --experimental-strip-types --test scripts/whop-membership-access.test.mts",
    "audit:hr-intelligence:selectors": "tsx scripts/hr-intelligence-game-selectors.mts",
    "audit:market-dna": "tsx scripts/audit-market-dna-date.mts",
    "backfill:market-dna": "tsx scripts/backfill-market-dna-archive.mts",
    "desktop:dev": "npm run dev --workspace @slipsurge/desktop",
    "desktop:build": "npm run build --workspace @slipsurge/desktop",
    "desktop:publish-update": "node scripts/publish-desktop-update.mjs",
    "desktop:doctor": "npm run doctor --workspace @slipsurge/desktop",
    "desktop:verify-release": "node scripts/verify-desktop-release.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.16.0",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-tabs": "^1.1.17",
    "@slipsurge/core": "*",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@types/web-push": "^3.6.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.7.0",
    "@vercel/speed-insights": "^2.0.0",
    "@whop/checkout": "^0.4.0",
    "@whop/embedded-components-react-js": "^1.2.0",
    "@whop/embedded-components-vanilla-js": "^1.2.0",
    "@whop/sdk": "^0.0.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next": "^16.3.0",
    "playwright-core": "^1.61.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "svix": "^1.99.1",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
